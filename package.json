{
  "name": "task-timer",
  "version": "0.3.0",
  "private": true,
  "description": "Single-user time tracker: projects, tasks, stints and daily sessions.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "vite build && node src/server/main.ts",
    "serve": "node src/server/main.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch src/server/main.ts\" \"vite\"",
    "build": "vite build",
    "check": "tsc -p .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/zod-validator": "0.9.1",
    "@mantine/core": "9.8.0",
    "@mantine/hooks": "9.8.0",
    "@mantine/notifications": "9.8.0",
    "@tabler/icons-react": "3.51.0",
    "@tanstack/react-query": "5.107.1",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
